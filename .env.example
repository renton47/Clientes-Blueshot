# =============================================================================
# BLUESHOT CLIENT PORTAL — Variables de Entorno
# =============================================================================
# INSTRUCCIONES:
# 1. Copia este archivo y renómbralo a: .env.local
# 2. Completa cada variable con sus valores reales
# 3. NUNCA subas .env.local a Git (ya está en .gitignore)
# =============================================================================

# -----------------------------------------------------------------------------
# SUPABASE — Obtener en: https://app.supabase.com → Tu proyecto → Settings → API
# -----------------------------------------------------------------------------

# URL del proyecto (ej: https://abcdefghijkl.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://TU_PROJECT_ID.supabase.co

# Clave pública anon (es segura para el navegador)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Clave service_role — SOLO para servidor, NUNCA en frontend
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Contraseña de la base de datos — Supabase → Settings → Database → Password
SUPABASE_DB_PASSWORD=tu_password_de_base_de_datos

# ID del proyecto — Supabase → General → Reference ID (ej: abcdefghijkl)
SUPABASE_PROJECT_ID=tu_project_id

# -----------------------------------------------------------------------------
# OPENAI — Obtener en: https://platform.openai.com/api-keys
# -----------------------------------------------------------------------------

OPENAI_API_KEY=sk-...

# Modelo a usar (recomendado: gpt-4o)
OPENAI_MODEL=gpt-4o

# -----------------------------------------------------------------------------
# SEGURIDAD — Generar con: openssl rand -base64 32
# -----------------------------------------------------------------------------

# Secreto JWT para tokens internos
JWT_SECRET=genera_con_openssl_rand_-base64_32

# Secreto para integración WordPress → Portal
WP_INTEGRATION_SECRET=genera_con_openssl_rand_-base64_32

# -----------------------------------------------------------------------------
# APLICACIÓN
# -----------------------------------------------------------------------------

# URL base de la app (sin barra final)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# URL de WordPress (para integración)
NEXT_PUBLIC_WP_URL=https://blueshot.cl

# Entorno: development | production
NODE_ENV=development
